# PINGME Environment Configuration

# Domain name for HTTPS reverse proxy (e.g. pingme.yourdomain.com or localhost)
DOMAIN=localhost

# Secure random secret key for HMAC and hashing (generate via: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-very-secure-random-32-byte-hex-string

# Initial Admin API Token for bootstrapping (must start with pm_)
# Set your initial token, e.g. pm_admin_secret_string_here
INITIAL_ADMIN_TOKEN=pm_change_this_to_a_secure_token

# VAPID / Web Push Configuration
# Leave blank to automatically generate persistent keys in data/vapid_keys.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@yourdomain.com

# Storage Directory
PINGME_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/pingme.db
